# Pareton Docker Compose. Keep this file shell-compatible for ops/deploy.sh.
# Copy to .env; only fill secrets on the deployment host.
# Host paths must be absolute when using the automatic deploy controller.
PARETON_REPO_DIR=/opt/pareton
PARETON_API_DOMAIN=api.pareton.ai
PARETON_API_PORT=8000
PARETON_HOST_WORK_DIR=/opt/pareton/.pareton-work
PARETON_HOST_BUILD_LOG_DIR=/var/log/pareton/builds
PARETON_DOCKER_CONFIG_DIR=/root/.docker
PARETON_DOCKER_SOCKET=/var/run/docker.sock
PARETON_WALLET_DIR=/root/.bittensor/wallets
PARETON_DEPLOY_SSH_DIR=/root/.ssh
PARETON_WORKER_STOP_GRACE_PERIOD=8h
PARETON_DEPLOY_INTERVAL_S=60

PARETON_DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
PARETON_TEST_DATABASE_URL=
PARETON_NETUID=10
PARETON_NETWORK=finney
# Optional ISO-8601 intake floor. The watcher compares this with the timestamp
# of each commitment's chain block and rejects older commitments.
PARETON_COMPETITION_START_DATETIME=

# Weight vector. Bumping the version key changes which validators trust-weight
# us, so announce it first; the burn UID takes emission no leader claimed.
PARETON_VERSION_KEY=2032
PARETON_BURN_UID=201
# 360 blocks is about 72 minutes. Off means compute and store but never sign.
PARETON_WEIGHTS_CADENCE_BLOCKS=360
PARETON_WEIGHTS_ENABLED=true

PARETON_WALLET_NAME=default
PARETON_WALLET_HOTKEY=default

# AWS S3 for miner patches (presigned PUT). Leave endpoint empty for AWS.
PARETON_S3_ENDPOINT_URL=
PARETON_S3_ACCESS_KEY=
PARETON_S3_SECRET_KEY=
PARETON_S3_BUCKET=pareton-s3
PARETON_S3_PREFIX=stage0
PARETON_S3_REGION=us-east-2
PARETON_S3_PUBLIC_BASE_URL=
# Miner upload signatures expire after this many seconds. Keep miner/API clocks
# synchronized. PUT URLs expire no later than the remaining authorization TTL.
PARETON_UPLOAD_AUTH_TTL_S=300
# Seconds after the first finalized scored/disqualified evaluation for submissions
# ingested by the updated watcher. Changes also affect their past evaluations;
# older submissions are exempt. Already published copies remain public.
# Restart the API after changing this value.
PARETON_PATCH_REVEAL_DELAY_S=172800

# Hugging Face (dataset/model downloads during workload pool build and bench)
HF_TOKEN=

# GHCR (hermetic builder push) — GitHub org Pareton-ai (lowercase on ghcr.io)
PARETON_GHCR_OWNER=pareton-ai
PARETON_GHCR_IMAGE=pareton-engine
PARETON_GHCR_USERNAME=
PARETON_GHCR_USER=
PARETON_GHCR_TOKEN=
PARETON_BASE_IMAGE=ghcr.io/pareton-ai/pareton-baseline:v0

# Hermetic compile (defaults are OOM-safe). Example on 4 vCPU/32GB: MAX_JOBS=2.
# PARETON_BUILD_MAX_JOBS=1
# PARETON_BUILD_TIMEOUT_S=7200
# Production builds and cleanup must name the same Buildx builder.
PARETON_BUILDER_NAME=default
PARETON_DOCKER_DAEMON_CONFIG_PATH=/etc/docker/daemon.json
PARETON_BUILDER_DOCKER_ROOT=/var/lib/docker
# PARETON_BUILDER_CLEANUP_HIGH_WATER_PERCENT=75
# PARETON_BUILDER_CLEANUP_HARD_WATER_PERCENT=90

# GPU pod orchestration
PARETON_TARGON_API_KEY=
PARETON_SHADEFORM_API_KEY=
PARETON_LIUM_API_KEY=
PARETON_RUNPOD_API_KEY=
# Ordered try-list (first → last) on no-capacity / provision error.
# runpod is opt-in: stock shared pods lack privileged/DinD for nested Docker.
PARETON_GPU_PROVIDERS=lium,shadeform,targon
# Optional Runpod knobs (add runpod to PARETON_GPU_PROVIDERS only after a
# Docker-capable image/account is confirmed).
# PARETON_RUNPOD_IMAGE=runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04
# PARETON_RUNPOD_CLOUD=ANY
PARETON_GPU_TTL_HOURS=2
PARETON_GPU_MAX_HOURLY_CENTS=1000
# Shared by round-worker, gpu-reap and CLI; preserve this path when migrating
# because pods.json records absolute SSH-key paths.
PARETON_GPU_STATE_DIR=/root/.cache/pareton/gpu
PARETON_GPU_VOLUME_GIB=250
PARETON_GPU_STATIC_SSH=
PARETON_GPU_SSH_KEY_PATH=
# Operator pubkeys added to each pod's authorized_keys; quoted, one per line.
PARETON_GPU_EXTRA_SSH_PUBKEYS=

PARETON_SUBMISSION_FEE_TAO=0.1
PARETON_PAYMENT_RECIPIENT_ADDRESS=5CiieAa5nzSMbw4LPkh2hqv9rfMPZX9ZfEcSjh3SYWNBzk3K

# Axiom observability (Vector log shipping). Ingest-only token; create in
# Axiom console after joining the Pareton org. Store on droplet only.
PARETON_AXIOM_TOKEN=
PARETON_AXIOM_DATASET=pareton-prod

# Frontend CORS (browser embeds). Default is *; pin in production, e.g.:
# PARETON_ALLOWED_ORIGINS=https://pareton.ai
PARETON_ALLOWED_ORIGINS=*
