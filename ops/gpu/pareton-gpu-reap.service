[Unit]
Description=Pareton GPU TTL reap (destroy expired workloads and volumes)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/pareton
EnvironmentFile=-/opt/pareton/.env
ExecStart=/opt/pareton/.venv/bin/python -m gpu reap
Nice=10

[Install]
WantedBy=multi-user.target
