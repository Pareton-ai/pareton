{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ParetonStage0PatchObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::pareton-s3/stage0/*"
    },
    {
      "Sid": "ParetonStage0EvidencePut",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": "arn:aws:s3:::pareton-s3/stage0/evidence/*"
    },
    {
      "Sid": "ParetonStage0ListPrefix",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::pareton-s3",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["stage0/*", "stage0/evidence/*"]
        }
      }
    }
  ]
}
