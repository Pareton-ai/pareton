[Unit]
Description=Pull-based deploy of /opt/pareton from origin/main
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Runs the /usr/local/bin copy, not the repo copy, so a git pull cannot
# rewrite the script while bash is executing it.
ExecStart=/usr/local/bin/pareton-deploy
Nice=10

[Install]
WantedBy=multi-user.target
