[Unit]
Description=Pull-based deploy of /opt/pareton from origin/main
After=network-online.target
Wants=network-online.target
# Direct team notification on failure; independent of the Vector/Axiom path.
OnFailure=pareton-deploy-failed.service

[Service]
Type=oneshot
# Runs the /usr/local/bin copy, not the repo copy, so a git pull cannot
# rewrite the script while bash is executing it. The deploy self-installs
# this copy atomically on its success path (ops/deploy.sh install_ops).
ExecStart=/usr/local/bin/pareton-deploy
Nice=10
# Stage-2 installs (venv copy, pip, 120s log acceptance) routinely exceed
# the systemd default of 90s; being killed here would strand applying
# (spec 4.5 fourth-round review, P1-1). Install waits are never force-cut.
TimeoutStartSec=infinity

[Install]
WantedBy=multi-user.target
