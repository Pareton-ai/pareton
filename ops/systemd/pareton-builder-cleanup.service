[Unit]
Description=Pareton persistent Docker builder cleanup
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/pareton
EnvironmentFile=/opt/pareton/.env
# Release gate before any venv-dependent step (spec 5.4 / B10).
ExecCondition=/usr/local/lib/pareton-ops/release.py gate --unit pareton-builder-cleanup
ExecStartPre=/opt/pareton/.venv/bin/python -m builder.gc_config
ExecStart=/opt/pareton/.venv/bin/python -m builder.cleanup
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
