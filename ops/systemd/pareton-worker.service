# Live submission worker unit for the production VPS.
# Reconstructed from a partial `systemctl cat` observation (2026-08-09):
# diff against the live unit before installing and keep any extra directives.
[Unit]
Description=Pareton submission gate and build worker (live)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/pareton
EnvironmentFile=/opt/pareton/.env
ExecStartPre=/opt/pareton/.venv/bin/python -m builder.gc_config
ExecStart=/opt/pareton/.venv/bin/python -m worker.main --queue submissions
Restart=on-failure
RestartSec=10
# The worker drains on SIGTERM (finishes the in-flight job before exiting).
# Native builds can take hours, so give a wide margin, then SIGKILL.
# Deployment defers restarts while a job is running, including lock waits.
TimeoutStopSec=8h

[Install]
WantedBy=multi-user.target
