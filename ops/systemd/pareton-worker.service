# Live (non-mock) worker unit for the production VPS.
# The mock variant used during Stage 0 bring-up adds `--mock-bench` to ExecStart.
# Reconstructed from a partial `systemctl cat` observation (2026-08-09):
# diff against the live unit before installing and keep any extra directives.
[Unit]
Description=Pareton Stage 0 gate + bench worker (live)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/pareton
EnvironmentFile=/opt/pareton/.env
ExecStart=/opt/pareton/.venv/bin/python -m worker.main --scan-chain
Restart=on-failure
RestartSec=10
# The worker drains on SIGTERM (finishes the in-flight job before exiting).
# Worst-case job is bounded by PARETON_BENCH_TIMEOUT_S (default 3h); allow
# margin, then SIGKILL.
TimeoutStopSec=4h

[Install]
WantedBy=multi-user.target
