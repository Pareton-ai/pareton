# Cadence process: compute the subnet weight vector, store it, and sign it.
# This unit holds the validator wallet. pareton-worker and pareton-watcher do not.
# Safe to restart at any time: an in-flight set that dies leaves the previous
# on-chain vector standing, which is the correct failure mode.
[Unit]
Description=Pareton weight setter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/pareton
EnvironmentFile=/opt/pareton/.env
ExecCondition=/usr/local/lib/pareton-ops/release.py gate --unit pareton-weights
ExecStartPre=/usr/local/lib/pareton-ops/release.py emit-probe --unit pareton-weights
ExecStart=/opt/pareton/.venv/bin/python -m weights
Restart=always
RestartSec=10
KillMode=mixed
# infinity: never cut an in-flight set_weights cycle at a release stop;
# forced interruption is an owner-authorized exception (spec 5.2).
TimeoutStopSec=infinity

[Install]
WantedBy=multi-user.target
