# Round execution has its own process so local builds cannot block its queue.
[Unit]
Description=Pareton round benchmark worker (live)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/pareton
EnvironmentFile=/opt/pareton/.env
ExecStart=/opt/pareton/.venv/bin/python -m worker.main --queue rounds
Restart=on-failure
RestartSec=10
# SIGTERM drains the current round, including GPU teardown, before exit.
TimeoutStopSec=8h

[Install]
WantedBy=multi-user.target
