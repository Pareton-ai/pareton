# Bittensor chain
CACHEON_NETWORK=finney
CACHEON_NETUID=14
CACHEON_WALLET_NAME=default
CACHEON_WALLET_HOTKEY=default
CACHEON_POLL_INTERVAL_S=600
CACHEON_DRY_RUN=0
CACHEON_BASELINE_IMAGE=vllm/vllm-openai:v0.22.0
CACHEON_BASELINE_DIGEST=sha256:0fec7ec5f3e6bc168e54899935fb0557da908a4832a1dbc88e2debcf2f889416
CACHEON_SCORING_IMAGE=vllm/vllm-openai:v0.9.2

# Submission payment gate (0 = disabled; must match miner --fee in RAO, 1 TAO = 1_000_000_000)
CACHEON_SUBMISSION_FEE_RAO=100000000

# Bittensor wallet directory (mounted read-only into container)
BITTENSOR_DIR=~/.bittensor

# Hippius S3 state sync
HIPPIUS_ACCESS_KEY=
HIPPIUS_SECRET_KEY=
CACHEON_S3_BUCKET=cacheon-validator
CACHEON_S3_PREFIX=state-mainnet
CACHEON_STATE_DIR=./state-mainnet

# GPU eval: set SSH target OR enable cloud auto-rent (not both)
CACHEON_GPU_SSH=              # user@host[:port]; pod with setup-gpu.sh already run
# CACHEON_GPU_POD_PROFILE=targon  # targon (default), lium, or shadeform
CACHEON_AUTO_RENT=0           # ignored when CACHEON_GPU_SSH is set
CACHEON_PREFERRED_PROVIDER=   # ignored when CACHEON_GPU_SSH is set
CACHEON_PREFERRED_GPU=        # ignored when CACHEON_GPU_SSH is set
LIUM_API_KEY=
TARGON_API_KEY=
SHADEFORM_API_KEY=
TARGON_VOLUME_UID=
# Targon only: persist vLLM torch.compile cache on /workspace (auto-rent sets this; optional override)
# CACHEON_VLLM_CACHE_DIR=/workspace/vllm-cache
CACHEON_MAX_HOURLY_PRICE=2000
HF_TOKEN=

# Emergency operator override for competition pool fraction (0.0-1.0); unset = block schedule
# CACHEON_EMISSION_FRAC_OVERRIDE=0.3